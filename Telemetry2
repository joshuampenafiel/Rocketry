def IMU_Setup():
    # Initialize I2C bus
    bus = smbus.SMBus(1)
    # Wake up MPU-6050 (it starts in sleep mode)
    bus.write_byte_data(MPU6050_ADDR, PWR_MGMT_1, 0)

def Barrometer_Setup():
